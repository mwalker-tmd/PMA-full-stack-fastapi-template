# Copy this file to .env and adjust the values: cp .env.example .env
# .env is gitignored. Never commit it, since it holds passwords and keys.
#
# The defaults below are for local development only. With FASTAPI_ENV=development,
# leftover "changethis" values only produce a warning. Without it, they are an error.
# Generate real values with: python -c "import secrets; print(secrets.token_urlsafe(32))"

# =============================================================================
# Required (no defaults; the app or Docker Compose will not start without them)
# =============================================================================

PROJECT_NAME="Full Stack FastAPI Project"

# Signs login tokens. Required, with no default.
SECRET_KEY=changethis

# The first admin account, created when the database is prepared
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=changethis

# Postgres password, used by the db service and in DATABASE_URL below
POSTGRES_PASSWORD=changethis

# Used by the backend when run locally (uv run fastapi dev). Docker Compose
# ignores this value and builds its own URL pointing at the db service.
DATABASE_URL=postgresql://postgres:${POSTGRES_PASSWORD}@localhost:5432/app

# =============================================================================
# Local development
# =============================================================================

# Downgrades the "changethis" errors above to warnings. Remove for deployments.
FASTAPI_ENV=development

# =============================================================================
# Email (optional; emails are sent only when SMTP_HOST and EMAILS_FROM_EMAIL are set)
# =============================================================================

# Defaults point at Mailpit (http://localhost:8025), which captures emails locally.
# Docker Compose sets the host to the mailpit service automatically.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_TLS=False
EMAILS_FROM_EMAIL=info@example.com
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_SSL=False
# EMAILS_FROM_NAME=          # defaults to PROJECT_NAME

# =============================================================================
# Optional (shown with their defaults)
# =============================================================================

# Base URL used for links in emails, e.g. password reset
# FRONTEND_HOST=http://localhost:5173

# Error tracking with Sentry
# SENTRY_DSN=

# Domain for Traefik routing (Docker Compose only; defaults to localhost)
# DOMAIN=localhost

# ACCESS_TOKEN_EXPIRE_MINUTES=11520   # 8 days
# EMAIL_RESET_TOKEN_EXPIRE_HOURS=48
