# Copy this file to .env and adjust the values: cp frontend/.env.example frontend/.env
# frontend/.env is gitignored.
#
# VITE_* variables are bundled into the browser JavaScript and are visible to
# anyone using the app. Never put secrets here.

# Backend URL for the Vite development server (bun run dev). Without it, the
# frontend calls its own origin, which is right when FastAPI serves the built frontend.
VITE_API_URL=http://localhost:8000

# Mailpit URL, used by the Playwright tests to read captured emails
MAILPIT_HOST=http://localhost:8025
